{
  "routes": [
    {
      "tenant_id": "*",
      "route_id": "support-agent",
      "version": "2026-10-02.1",
      "codec": "toon",
      "state": "SHADOW",
      "min_payload_tokens": 200,
      "min_net_savings": 0.15,
      "output_price_ratio": 4,
      "shadow_sample_rate": 0.05,
      "audit_sample_rate": 0.01,
      "allow_fallback_retry": true,
      "validate": true,
      "tool_schemas": {
        "refund_order": {
          "type": "object",
          "required": ["order_id", "amount", "tenant_id"],
          "properties": {
            "order_id": {"type": "integer"},
            "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
            "tenant_id": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "redact_keys": ["email", "phone"]
    },
    {
      "tenant_id": "*",
      "route_id": "analytics-chat",
      "codec": "tabular",
      "state": "OFF"
    }
  ]
}
